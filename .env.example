# Clé d'accès API Web3Forms (obtenue gratuitement sur https://web3forms.com).
# Laissée vide, le formulaire de devis fonctionne en mode démonstration.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Projet Sanity de CARZONE (administration /admin).
# Laissé vide, le site lit data/catalogue.json.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret partagé avec le webhook Sanity → /api/revalidate (mise à jour du site après publication).
SANITY_REVALIDATE_SECRET=

# Jeton « Editor » utilisé uniquement par scripts/seed-sanity.mjs pour le transfert initial.
# Ne pas l'ajouter dans Vercel.
SANITY_WRITE_TOKEN=
